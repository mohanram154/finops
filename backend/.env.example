# NEXUS AI FINOPS - Backend Environment Configuration

# Operating Mode: 'real' (or 'simulation') vs 'real'
APP_MODE=real

# Environment: 'development', 'staging', 'production'
ENVIRONMENT=development

# Server Settings
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Selection Priority: mongodb -> postgresql -> sqlite (detected fallback: sqlite)
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///./nexus_finops.db

# Cache Priority: redis -> inmemory (detected fallback: inmemory)
CACHE_TYPE=inmemory
REDIS_URL=redis://localhost:6379/0

# Cloud / LLM API Keys (Required for 'real' mode, simulated in 'real' mode)
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GCP_SERVICE_ACCOUNT_KEY=
AZURE_SUBSCRIPTION_ID=

