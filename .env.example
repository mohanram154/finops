# NEXUS AI FINOPS - Root Environment Variables Example

# Backend Mode: real (or simulation) | real
APP_MODE=real

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database & Cache (Detected SQLite + InMemory)
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///./nexus_finops.db
CACHE_TYPE=inmemory

# Frontend Vite API Base URL
VITE_API_BASE_URL=http://127.0.0.1:8000

